# Copy to .env in this directory. Compose reads that file. Do not commit .env.
#
# Generate the three required values before the first start:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(24))"
#
# POSTGRES_PASSWORD must be letters and digits. A symbol breaks DJANGO_DB_URL.
# Postgres applies that password only when the data volume is first created.
# A volume created earlier with trust authentication does not switch over by itself.
# An existing database must keep the FIELD_ENCRYPTION_KEY it was written with.
# Changing the key makes stored connection passwords unreadable.

DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Hosts you open in the browser. Add every name and address, without a port.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Vilnius

# Optional. Leave the password unset to skip creating a superuser.
# SUPERUSER_NAME=admin
# SUPERUSER_EMAIL=admin@example.com
# SUPERUSER_PASSWORD=

# Optional extra CSRF origins. Include the scheme and port.
# CSRF_TRUSTED_ORIGINS=https://desktop.example.com:10443
