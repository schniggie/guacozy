# Copy to guacozy_server/.env for manage.py on the host. Do not commit that file.
# Compose uses the repo-root .env instead. See /.env.example.
#
# Generate a signing key and a field key before the first start:
#   ../.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
#   ../.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Keep FIELD_ENCRYPTION_KEY stable. A new value cannot read passwords already stored.

DEBUG=True
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Vilnius

# https://django-environ.readthedocs.io/en/latest/#supported-types
# DJANGO_DB_URL=sqlite:///db.sqlite3
# DJANGO_DB_URL=postgres://postgres:lettersAndDigits@127.0.0.1:5432/postgres

# CACHE_URL=memcache://127.0.0.1:11211
# CACHE_URL=locmemcache://
